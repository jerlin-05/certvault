# MongoDB connection string (MongoDB Atlas or local)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/certvault

# Secret used to sign login sessions — set a long random string
JWT_SECRET=replace-this-with-a-long-random-string

# SMTP settings used to send expiry-alert emails.
# Any SMTP provider works (Gmail app password, SendGrid, Mailgun, Resend SMTP, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM="CertVault <alerts@certvault.app>"

# Shared secret required to call /api/cron/check-expiry from an external scheduler
CRON_SECRET=replace-this-with-another-random-string

# Base URL of the deployed app, used inside alert emails to link back
APP_URL=http://localhost:3000
